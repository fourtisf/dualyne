// Dualyne database schema. Tables are added phase by phase; see PLAN.md §3.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  explorer
  holder
  builder
}

/// Maps a public Dualyne model id to the OpenRouter model that serves it.
model Model {
  id               String     @id // Dualyne id, e.g. "claude-swift"
  name             String // "Claude Swift"
  menuName         String // "OpenAI GPT" (Compare menus)
  provider         String // "Anthropic"
  providerColor    String
  bestFor          String
  speed            Int // 1–4 bars
  minTier          Tier
  sortOrder        Int
  enabled          Boolean    @default(true)
  openrouterId     String // "anthropic/claude-haiku-4.5"
  openrouterFamily String // "anthropic/claude-haiku" (used to suggest newer ids)
  upstreamName     String // "Claude Haiku 4.5"
  /// USD per token, refreshed daily from OpenRouter's catalog.
  promptPrice      Decimal    @db.Decimal(18, 12)
  completionPrice  Decimal    @db.Decimal(18, 12)
  contextLength    Int?
  lastVerifiedAt   DateTime?
  /// Set when the mapped OpenRouter id disappeared from OpenRouter's catalog.
  missingSince     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  usage            UsageLog[]
}

model Wallet {
  id           String         @id @default(cuid())
  address      String         @unique // lowercase 0x…
  /// Tier set by an admin (test keys before on-chain tiers exist).
  tierOverride Tier?
  createdAt    DateTime       @default(now())
  keys         ApiKey[]
  usage        UsageLog[]
  sessions     Session[]
  credits      CreditAccount?
  deposits     Deposit[]
}

/// Signed-in browser session (Sign-In With Ethereum). The id is an HMAC of the cookie value.
model Session {
  id         String   @id
  walletId   String
  wallet     Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())

  @@index([walletId])
  @@index([expiresAt])
}

/// Only the SHA-256 hash of a key is stored. Revoking a key deletes its row.
model ApiKey {
  id         String     @id @default(cuid())
  walletId   String
  wallet     Wallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  hash       String     @unique // hex SHA-256 of the full key
  last4      String
  name       String?
  createdAt  DateTime   @default(now())
  lastUsedAt DateTime?
  usage      UsageLog[]

  @@index([walletId])
}

/// One row per upstream model call. Prompt and answer text are never stored.
model UsageLog {
  id              BigInt   @id @default(autoincrement())
  createdAt       DateTime @default(now())
  source          String // "api" | "compare" | "chat" | "telegram"
  apiKeyId        String?
  apiKey          ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  walletId        String?
  wallet          Wallet?  @relation(fields: [walletId], references: [id], onDelete: SetNull)
  walletAddress   String?
  modelId         String
  model           Model    @relation(fields: [modelId], references: [id])
  openrouterId    String
  generationId    String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  /// 1 = $0.000001
  costMicroUsd    BigInt   @default(0)
  /// What a Builder wallet was charged from prepaid credits (cost × markup). 0 = paid by the treasury.
  chargedMicroUsd BigInt   @default(0)
  latencyMs       Int
  ttftMs          Int?
  status          Int
  errorCode       String?
  stream          Boolean
  /// HMAC of the client IP (compare requests). The raw IP is never stored.
  ipHash          String?
  compareId       String?

  @@index([createdAt])
  @@index([walletId, createdAt])
  @@index([apiKeyId, createdAt])
  @@index([compareId])
}

/// One row per Compare run on the website. Votes (later phase) must reference a completed run.
model CompareRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  modelA     String
  modelB     String
  ipHash     String
  completedA Boolean  @default(false)
  completedB Boolean  @default(false)
  /// Blind run: the server picked the models and hides them until the vote.
  blind      Boolean  @default(false)
  vote       Vote?

  @@index([createdAt])
}

/// One community vote per completed Compare run (Phase 5).
model Vote {
  id        String     @id @default(cuid())
  compareId String     @unique
  compare   CompareRun @relation(fields: [compareId], references: [id], onDelete: Cascade)
  modelA    String
  modelB    String
  winner    String // "a" | "b" | "tie"
  blind     Boolean
  walletId  String?
  ipHash    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([createdAt])
}

/// Elo ratings, recomputed nightly from all votes (K=24, start 1000).
model EloRating {
  modelId   String   @id
  rating    Float
  wins      Int
  losses    Int
  ties      Int
  games     Int
  updatedAt DateTime @updatedAt
}

/// Prepaid Builder credit per wallet, in micro-USD.
model CreditAccount {
  walletId        String   @id
  wallet          Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  balanceMicroUsd BigInt   @default(0)
  updatedAt       DateTime @updatedAt
}

/// On-chain top-ups, verified by transaction hash. Each transaction credits once.
model Deposit {
  id        String   @id @default(cuid())
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  txHash    String   @unique
  asset     String // "USDG" | "ETH"
  amount    String // token amount as a decimal string
  usdMicro  BigInt
  createdAt DateTime @default(now())

  @@index([walletId, createdAt])
}

/// History of the daily OpenRouter catalog check.
model ModelCheck {
  id      String   @id @default(cuid())
  ranAt   DateTime @default(now())
  ok      Boolean
  missing String[]
  details Json
}

/// Stablecoin transfers into the treasury wallet, read from the chain (Phase 4).
model TreasuryTransfer {
  id             String   @id // "<txHash>:<logIndex>"
  txHash         String
  blockNumber    BigInt
  timestamp      DateTime
  fromAddress    String
  amountMicroUsd BigInt

  @@index([timestamp])
}

/// Treasury balance readings (stablecoin balanceOf), taken by the hourly sync.
model TreasurySnapshot {
  id              String   @id @default(cuid())
  takenAt         DateTime @default(now())
  balanceMicroUsd BigInt

  @@index([takenAt])
}

/// Last block scanned by a chain job, so scans resume where they stopped.
model ChainCursor {
  name      String   @id
  block     BigInt
  updatedAt DateTime @updatedAt
}

/// A comparison someone chose to publish with a link. Only created when they click Share.
/// A chat conversation someone chose to share (Share button on the Chat page). Every answer in it
/// was checked against the fingerprints of answers Dualyne itself produced for that visitor.
model ChatShare {
  id              String   @id // short public id used in /c/<id>
  modelId         String
  title           String
  /// [{ role: "user" | "assistant", content: string }]
  messages        Json
  /// SHA-256 of the delete token returned once to the creator's browser.
  deleteTokenHash String
  ipHash          String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model Share {
  id              String   @id // short public id used in /s/<id>
  compareId       String   @unique
  prompt          String
  modelA          String
  modelB          String
  answerA         String
  answerB         String
  /// SHA-256 of the delete token returned once to the creator's browser.
  deleteTokenHash String
  createdAt       DateTime @default(now())
}
