# Local development. Copy to .env and adjust. Production uses .env.production.example instead.
LOG_LEVEL=info

# Domain shown on the site and in code samples (placeholder brand domain).
SITE_DOMAIN=dualyne.com
NEXT_PUBLIC_SITE_DOMAIN=dualyne.com

# API
API_PORT=4000
WEB_ORIGINS=http://localhost:3000
TRUST_PROXY=false
DATABASE_URL=postgresql://dualyne:dualyne@localhost:5432/dualyne
REDIS_URL=redis://localhost:6379/0

# OpenRouter: server only, never exposed to the browser.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Cloudflare Turnstile. These are Cloudflare's public test keys (always pass).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Safety rails
DAILY_BUDGET_USD=100
COMPARE_LIMIT_PER_HOUR=10
COMPARE_MAX_TOKENS=1000
# Free Chat page: messages per IP per hour (free models only)
CHAT_LIMIT_PER_HOUR=30

IP_HASH_SECRET=dev-only-change-me-dev-only-change-me
ALERT_WEBHOOK_URL=
JOBS_ENABLED=false

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
API_INTERNAL_URL=http://localhost:4000

# Wallet sign-in (SIWE)
SESSION_SECRET=dev-only-session-secret-change-me-000000
SIWE_CHAIN_ID=1
NEXT_PUBLIC_SIWE_CHAIN_ID=1
# Optional: JSON-RPC for on-chain reads (sybil check, token tier, treasury, deposits)
RPC_URL=
SYBIL_CHECK=auto
EXPLORER_API_URL=
EXPLORER_API_KEY=
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Community links (https://…). Empty: X and Telegram show as "coming soon".
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
