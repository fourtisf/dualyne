# ─────────────────────────────────────────────────────────────────────────────
# Production settings. Copy to /opt/dualyne/.env ON THE SERVER ONLY and fill in.
# Never commit the real file. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Your domain, without https:// or www. The site is https://SITE_DOMAIN,
# the API is https://api.SITE_DOMAIN.
SITE_DOMAIN=example.com
# Origins allowed to call the API with cookies (site sign-in, Compare).
WEB_ORIGINS=https://example.com,https://www.example.com

LOG_LEVEL=info

# ── Database (Postgres runs inside Docker, never exposed) ──
POSTGRES_USER=dualyne
# Secret: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dualyne
# Must match the three values above. "postgres" is the container name.
DATABASE_URL=postgresql://dualyne:change-me@postgres:5432/dualyne

# ── Redis (rate limits, quotas, spend counter) ──
# Secret: openssl rand -hex 24
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# ── OpenRouter (the only model provider). Secret, server only. ──
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Dualyne

# ── Cloudflare Turnstile (bot check on Compare). Dashboard → Turnstile → Add site. ──
# The site key is public (baked into the website); the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Safety rails ──
# Free tiers stop (429) for the rest of the UTC day once this much is spent.
DAILY_BUDGET_USD=100
COMPARE_LIMIT_PER_HOUR=10
COMPARE_MAX_TOKENS=1000
# Free plan: chat messages per person per day (free models only)
CHAT_LIMIT_PER_DAY=20
# Optional overrides of the launch tier limits:
# TIER_EXPLORER_DAILY=20
# TIER_HOLDER_DAILY=250
# TIER_EXPLORER_MAX_TOKENS=1000
# TIER_HOLDER_MAX_TOKENS=4000

# Secret used to hash IP addresses (32+ chars): openssl rand -hex 32
IP_HASH_SECRET=change-me-to-64-hex-chars
# Optional: Slack/Discord/Telegram-bridge webhook for alerts (budget hit, model missing,
# OpenRouter out of credits).
# Telegram alerts: bot token from @BotFather and your chat id (deploy/pm2/ops.sh telegram sets both)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert when OpenRouter credit falls below this many USD (0 = off)
OPENROUTER_LOW_BALANCE_USD=2
ALERT_WEBHOOK_URL=
JOBS_ENABLED=true

# ── Wallet sign-in (Phase 3) ──
# Secret for session cookies: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-chars
# Chain users sign in on and hold the token on. 1 = Ethereum, 8453 = Base, 42161 = Arbitrum.
SIWE_CHAIN_ID=8453
# JSON-RPC endpoint for that chain (Alchemy, Infura, QuickNode, …). Secret if it contains a key.
RPC_URL=
# Optional WalletConnect (phones without a wallet browser): https://cloud.reown.com → project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Sybil check for the free Explorer tier: the wallet needs at least this much native ETH (in wei)…
SYBIL_MIN_ETH_WEI=1000000000000000
# …or to be older than this many days (needs an Etherscan-compatible API below).
SYBIL_MIN_WALLET_AGE_DAYS=30
# Etherscan API v2 works for every chain: https://api.etherscan.io/v2/api  (key from etherscan.io)
EXPLORER_API_URL=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=

# ── Token and treasury (Phase 4). Leave empty until launch. ──
DLYN_TOKEN_ADDRESS=
HOLDER_MIN_DLYN=100000
TREASURY_WALLET_ADDRESS=
# Stablecoin the treasury holds and Builders top up with (USDG). 1 token = $1.
USDG_TOKEN_ADDRESS=
# First block to scan for treasury inflows (the block the treasury wallet started receiving fees).
TREASURY_START_BLOCK=
# Confirmations before inflows and top-ups count.
CHAIN_CONFIRMATIONS=3
# Links shown in the Token section.
NEXT_PUBLIC_DLYN_BUY_URL=
NEXT_PUBLIC_DLYN_CHART_URL=
# Block explorer base URL, e.g. https://basescan.org
NEXT_PUBLIC_EXPLORER_URL=
# Community links (https://…). Empty: the site shows X and Telegram as "coming soon".
# Show the $DLYN token (CA bar, Token and Treasury sections, Holder tier, bot /token). Off by default.
NEXT_PUBLIC_TOKEN_ENABLED=false
# Contact address on the About, Terms and Privacy pages (default hello@<domain>). Make sure the mailbox exists.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ── Payments: Pro plan and Builder credits ──
# Needs RPC_URL and SIWE_CHAIN_ID (8453 = Base recommended) set above.
# Address that receives Pro payments and Builder top-ups (your own wallet).
DEPOSIT_ADDRESS=
# Stablecoins accepted at $1 each, as SYMBOL:contract on the same chain, comma-separated.
# Check each address on the chain's explorer. Base USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
STABLECOINS=
# Chainlink ETH/USD price feed on your chain, to accept ETH. Empty = stablecoins only.
ETH_USD_FEED_ADDRESS=
BUILDER_MARKUP=1.15
# Pro plan: price in USD for PRO_DAYS days, daily messages, premium-model messages and
# fair-use cap (USD of premium model cost per PRO_DAYS), and the longest answer.
# Take Pro payments. false = the site shows Pro as "Coming soon".
PRO_OPEN=false
PRO_PRICE_USD=19
PRO_DAYS=30
PRO_CHAT_PER_DAY=300
PRO_PREMIUM_PER_DAY=30
PRO_FAIR_USE_USD=15
PRO_MAX_TOKENS=2000

# ── Community leaderboard (Phase 5) ──
# optional = people choose models (Blind is a toggle). always = every comparison is blind and only
# blind votes are ranked. Switch to "always" if you see vote manipulation.
COMPARE_BLIND_MODE=optional
# Votes are accepted this many hours after a comparison.
VOTE_WINDOW_HOURS=24

# ── Backups ──
BACKUP_DIR=/var/backups/dualyne
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR_UTC=3
