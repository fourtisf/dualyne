# ─────────────────────────────────────────────────────────────────────────────
# Production settings. Copy to /opt/refract/.env ON THE SERVER ONLY and fill in.
# Never commit the real file. Generate secrets with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# Your domain, without https:// or www. The site is https://SITE_DOMAIN,
# the API is https://api.SITE_DOMAIN.
SITE_DOMAIN=example.com
# Origins allowed to call the API with cookies (site sign-in, Compare).
WEB_ORIGINS=https://example.com,https://www.example.com

LOG_LEVEL=info

# ── Database (Postgres runs inside Docker, never exposed) ──
POSTGRES_USER=refract
# Secret: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
POSTGRES_DB=refract
# Must match the three values above. "postgres" is the container name.
DATABASE_URL=postgresql://refract:change-me@postgres:5432/refract

# ── Redis (rate limits, quotas, spend counter) ──
# Secret: openssl rand -hex 24
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# ── OpenRouter (the only model provider). Secret, server only. ──
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_TITLE=Refract

# ── Cloudflare Turnstile (bot check on Compare). Dashboard → Turnstile → Add site. ──
# The site key is public (baked into the website); the secret key stays on the server.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAA...
TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# ── Safety rails ──
# Free tiers stop (429) for the rest of the UTC day once this much is spent.
DAILY_BUDGET_USD=100
COMPARE_LIMIT_PER_HOUR=10
COMPARE_MAX_TOKENS=1000
# Optional overrides of the launch tier limits:
# TIER_EXPLORER_DAILY=20
# TIER_HOLDER_DAILY=250
# TIER_EXPLORER_MAX_TOKENS=1000
# TIER_HOLDER_MAX_TOKENS=4000

# Secret used to hash IP addresses (32+ chars): openssl rand -hex 32
IP_HASH_SECRET=change-me-to-64-hex-chars
# Optional: Slack/Discord/Telegram-bridge webhook for alerts (budget hit, model missing,
# OpenRouter out of credits).
ALERT_WEBHOOK_URL=
JOBS_ENABLED=true

# ── Wallet sign-in (Phase 3) ──
# Secret for session cookies: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-chars
# Chain users sign in on and hold the token on. 1 = Ethereum, 8453 = Base, 42161 = Arbitrum.
SIWE_CHAIN_ID=8453
# JSON-RPC endpoint for that chain (Alchemy, Infura, QuickNode, …). Secret if it contains a key.
RPC_URL=
# Optional WalletConnect (phones without a wallet browser): https://cloud.reown.com → project id.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Sybil check for the free Explorer tier: the wallet needs at least this much native ETH (in wei)…
SYBIL_MIN_ETH_WEI=1000000000000000
# …or to be older than this many days (needs an Etherscan-compatible API below).
SYBIL_MIN_WALLET_AGE_DAYS=30
# Etherscan API v2 works for every chain: https://api.etherscan.io/v2/api  (key from etherscan.io)
EXPLORER_API_URL=https://api.etherscan.io/v2/api
EXPLORER_API_KEY=

# ── Token and treasury (Phase 4). Leave empty until launch. ──
RFX_TOKEN_ADDRESS=
HOLDER_MIN_RFX=100000
TREASURY_WALLET_ADDRESS=
# Stablecoin the treasury holds and Builders top up with (USDG). 1 token = $1.
USDG_TOKEN_ADDRESS=
# Links shown in the Token section.
NEXT_PUBLIC_RFX_BUY_URL=
NEXT_PUBLIC_RFX_CHART_URL=
# Block explorer base URL, e.g. https://basescan.org
NEXT_PUBLIC_EXPLORER_URL=

# ── Builder credits (Phase 5) ──
# Address that receives Builder top-ups (can be the treasury wallet).
DEPOSIT_ADDRESS=
# Chainlink ETH/USD price feed on your chain, to credit ETH top-ups. Empty = USDG only.
ETH_USD_FEED_ADDRESS=
DEPOSIT_CONFIRMATIONS=3
BUILDER_MARKUP=1.15

# ── Backups ──
BACKUP_DIR=/var/backups/refract
BACKUP_RETENTION_DAYS=7
BACKUP_HOUR_UTC=3
